# ---- 依赖 ----
node_modules/
app/node_modules/

# ---- 构建产物 ----
app/dist/
release/
dist/
app/.pw-browsers/*
!app/.pw-browsers/README.txt
*.exe
*.blockmap

# vendor 里的可执行文件是程序的一部分，必须进仓库
!app/vendor/whisper/*.exe
!app/vendor/input/*.exe
!app/vendor/winserve/*.exe

# ---- 本地运行数据 / 日志 ----
app/shots/
shots/
*.log
debug.log

# ---- 本地快照、备份、素材包（体积大 / 与源码无关，不进仓库）----
snapshots/
app-modified-backup/
.worktrees/
*.zip
ref/*.mp4
ref/_extracted/

# ---- 系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Python 缓存（DTW 实验脚本用）----
__pycache__/
*.pyc

# convenience files placed for the user at repo root (shortcut + readme), not source
*.lnk
启动说明.txt

# dsh-pet 插件的数据与 Electron 运行时（由 DSH 管理，不入库）
/dsh-pet/

# Coopanion 桌宠（独立 git 仓库，源码从 GitHub clone，不入本库）
/Coopanion/
